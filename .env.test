# Used by `pytest` (tests/conftest.py loads it). Points at throwaway services.
KSL_ENV=test
KSL_LOG_LEVEL=WARNING
KSL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ksl_test
KSL_DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/ksl_test
KSL_REDIS_URL=redis://localhost:6379/15
KSL_S3_ENDPOINT=http://localhost:9000
KSL_S3_ACCESS_KEY=minio
KSL_S3_SECRET_KEY=test-secret
KSL_JWT_KID=test
KSL_JWT_PRIVATE_KEY_PEM=
KSL_JWT_PUBLIC_KEY_PEM=
KSL_API_KEY_PEPPER=test-pepper-test-pepper-test-pepper
KSL_OTP_PEPPER=test-otp-pepper
KSL_SMS_PROVIDER=console
KSL_WORKER_DEVICE=cpu
KSL_METRICS_ENABLED=false
