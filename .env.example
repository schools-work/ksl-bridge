# ------------------------------------------------------------------ KSL Bridge environment (copy to .env)
# Every variable is read by app/settings.py (prefix KSL_). Never commit a real .env.

KSL_ENV=dev                                   # dev | test | staging | prod
KSL_LOG_LEVEL=INFO
KSL_PUBLIC_BASE_URL=http://localhost:8000
KSL_CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL 16 + pgvector (async URL for the app, sync URL for psql/alembic)
KSL_DATABASE_URL=postgresql+asyncpg://ksl_app_login:change-me@localhost:5432/ksl
KSL_DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/ksl
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ksl
KSL_APP_DB_PASSWORD=change-me                 # password for the ksl_app_login role (created by db/seeds/dev_users.sql)

# Redis 7 (streams, pub/sub, session state)
KSL_REDIS_URL=redis://localhost:6379/0

# MinIO / S3
KSL_S3_ENDPOINT=http://localhost:9000
KSL_S3_ACCESS_KEY=minio
KSL_S3_SECRET_KEY=change-me-minio-secret
KSL_S3_REGION=us-east-1
KSL_S3_BUCKET_DATASETS=datasets
KSL_S3_BUCKET_MODELS=models
KSL_S3_BUCKET_KB=kb
KSL_S3_BUCKET_SIGN_DICT=sign-dict
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-minio-secret

# Auth: Ed25519 PEM keys (generate with `make keys`). Use \n for newlines.
KSL_JWT_KID=dev-2026-11
KSL_JWT_PRIVATE_KEY_PEM=
KSL_JWT_PUBLIC_KEY_PEM=
KSL_JWT_ISSUER=ksl-bridge
KSL_JWT_AUDIENCE=ksl-bridge-clients
KSL_ACCESS_TTL_SECONDS=900
KSL_REFRESH_TTL_DAYS=30
KSL_GUEST_TTL_SECONDS=7200
KSL_API_KEY_PEPPER=change-me-32-bytes-of-randomness
KSL_OTP_PEPPER=change-me-otp-pepper
KSL_DATA_ENCRYPTION_KEY=                     # 32-byte base64 key for AES-GCM (TOTP secrets, adapter creds)

# SMS gateway for OTP (non-AI third party; leave empty in dev → codes logged to console in dev only)
KSL_SMS_PROVIDER=console
KSL_SMS_API_KEY=
KSL_SMS_SENDER_ID=KSLBRIDGE

# Real-time
KSL_WS_MAX_FRAME_BYTES=65536
KSL_WS_HEARTBEAT_SECONDS=15
KSL_WS_IDLE_TIMEOUT_SECONDS=60
KSL_WS_MAX_INFLIGHT_LANDMARK_BATCHES=8

# Pipeline
KSL_ENDPOINT_STILL_MS=450
KSL_MAX_UTTERANCE_SECONDS=20
KSL_CLARIFY_COST=0.15
KSL_JOB_DEADLINE_MS=1500

# ML / registry
KSL_MLFLOW_TRACKING_URI=http://localhost:5000
KSL_MODEL_CACHE_DIR=./artifacts/model_cache
KSL_WORKER_DEVICE=cpu                         # cuda | cpu
KSL_WORKER_BATCH_MAX=32
KSL_WORKER_BATCH_WAIT_MS=15

# Observability
KSL_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
KSL_METRICS_ENABLED=true
